{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // The marketing page at atteo.dev. A separate Worker from the app (../wrangler.jsonc, served at app.atteo.dev):
  // one fetch handler, inline HTML, no bindings. The app's address is APP_URL in src/index.ts.
  "name": "atteo-landing",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,
  // The share image (og.png) is bundled as bytes and served at /og.png.
  "rules": [{ "type": "Data", "globs": ["**/*.png"], "fallthrough": true }]
}
