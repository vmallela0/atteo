{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // atteo.dev: the marketing page in front of the app. A separate Worker from the app (../wrangler.jsonc): it answers
  // the signed-out home page, /og.png, /robots.txt and /sitemap.xml itself and forwards everything else to APP_ORIGIN.
  "name": "atteo-landing",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,
  // The share image (og.png) is bundled as bytes and served at /og.png; jxn's pages (landing-jxn.html, jxn-pages/*.html) as text.
  "rules": [{ "type": "Data", "globs": ["**/*.png"], "fallthrough": true }, { "type": "Text", "globs": ["**/landing-jxn.html", "**/jxn-pages/*.html"], "fallthrough": true }],
  // The app itself, called directly (a Worker can't fetch another workers.dev address on the same account: error 1042).
  // Without it (wrangler dev), requests go to APP_ORIGIN.
  "services": [{ "binding": "APP", "service": "agent-board" }],
  "vars": {
    // The app Worker every other request is forwarded to. Locally: --var APP_ORIGIN:http://127.0.0.1:8815
    "APP_ORIGIN": "https://agent-board.vedu-mallela.workers.dev"
    // Optional: CF_WEB_ANALYTICS_TOKEN (Cloudflare Web Analytics) adds the beacon on the signed-out home page only. Unset: no snippet. See docs/ANALYTICS.md.
  }
}
