{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-board",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "workers_dev": true,
  "preview_urls": false,
  "triggers": { "crons": ["*/5 * * * *"] },
  // The agent skill (skills/agent-soup/SKILL.md) is bundled as text and served at /skill.md.
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "durable_objects": {
    "bindings": [{ "name": "BOARD", "class_name": "Board" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Board"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-board",
      "database_id": "74f82c17-1d1f-481f-8122-42c81de3342e",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "WORKOS_CLIENT_ID": "client_01M3XKJWX8TW7YAMPZVJZFJYHT",
    "ADMIN_EMAIL": "vedu.mallela@gmail.com"
  }
  // Secrets (wrangler secret put): WORKOS_API_KEY, ADMIN_KEY. Locally they come from .dev.vars.
}
