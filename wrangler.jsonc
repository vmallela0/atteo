{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-board",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_als"], // Sentry keeps per-request context with AsyncLocalStorage
  "observability": { "enabled": true },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "workers_dev": true,
  "preview_urls": false,
  // CPU ceiling per invocation (HTTP and this Worker's Durable Objects), pinned at the Workers Paid default of 30s.
  // Active compute only: waiting on D1, a Durable Object, or fetch does not count, so long-polls are unaffected.
  // wrangler dev does not enforce it (ship.sh and CI). The Free plan rejects this key at deploy (error 100328);
  // delete `limits` there. Measurements and when to tighten: docs/CLOUDFLARE_HARDENING.md.
  "limits": { "cpu_ms": 30000 },
  "triggers": { "crons": ["*/5 * * * *"] },
  // The agent skill (skills/atteo/SKILL.md) is bundled as text and served at /skill.md.
  "rules": [{ "type": "Text", "globs": ["**/*.md", "**/atteo.mjs"], "fallthrough": true }, { "type": "Data", "globs": ["**/*.woff2"], "fallthrough": true }],
  // Mermaid's UMD build (public/mermaid.min.js): served at /mermaid.min.js so the CSP does not allow a CDN.
  // run_worker_first keeps every other route on the Worker; mermaid.ts fetches this binding and sets cache/SRI CORS.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  // The CLI is bundled into one file and served at /cli/atteo.mjs (curl …/install.sh | sh installs it).
  "build": { "command": "npm run -s build:cli" },
  "durable_objects": {
    // SLACK: one object per Slack workspace, its outbound queue (src/slackQueue.ts); idle until the Slack app is set up.
    "bindings": [{ "name": "BOARD", "class_name": "Board" }, { "name": "SLACK", "class_name": "SlackTeam" }, { "name": "MAILBOX_SIGNAL", "class_name": "MailboxSignal" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Board"] }, { "tag": "v2", "new_sqlite_classes": ["SlackTeam"] }, { "tag": "v3", "new_sqlite_classes": ["MailboxSignal"] }],
  // Per-IP cap on signed-out endpoints that write a row or wake a board each call (limits.ts publicAllowed, vedu #4598):
  // 20 a minute per address per endpoint. The Rate Limiting binding counts in memory at each location: no D1 per request.
  "ratelimits": [{ "name": "PUBLIC_WRITES", "namespace_id": "4598", "simple": { "limit": 20, "period": 60 } }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-board",
      "database_id": "74f82c17-1d1f-481f-8122-42c81de3342e",
      "migrations_dir": "migrations"
    }
  ],
  // Nightly encrypted backups (src/backup.ts, docs/BACKUPS.md; vedu #5342: on Cloudflare, R2 in this account). The bucket
  // expires objects after 30 days. Local wrangler dev gets a local bucket under --persist-to, never this one. Backups stay
  // off until the BACKUP_PUBLIC_KEY secret is set (a secret, not a var, so local and test servers don't back up).
  "r2_buckets": [{ "binding": "BACKUP_R2", "bucket_name": "atteo-backups" }],
  "vars": {
    "WORKOS_CLIENT_ID": "client_01M3XKJWX8TW7YAMPZVJZFJYHT",
    // Not a secret: with the CF_ANALYTICS_TOKEN secret it turns on the cost guard (costGuard.ts, docs/COSTS.md) and the
    // load shedder's D1 reading (limits.ts). Without it both stay off (vedu #4598).
    "CF_ACCOUNT_ID": "5c5abf88c9f41e72eb1ac2691fb03a6e",
    // Board calls (src/calls.ts): the Cloudflare Realtime SFU app "atteo"; its token is the CF_REALTIME_APP_TOKEN secret (vedu #5487).
    "CF_REALTIME_APP_ID": "45474507d7c28eeac29cf780f30d9428",
    "ADMIN_EMAIL": "vedu.mallela@gmail.com,jxn@blxmail.com",
    // The public address (proxied to this workers.dev Worker from another account): sign-in callback, emails, OAuth/A2A
    // metadata, install.sh and webhook links all point here. Requests to localhost keep their own origin (src/util.ts publicOrigin).
    "PUBLIC_URL": "https://atteo.dev",
    // Voice + read-aloud caps (vedu #1582: strict; #1584: operators exempt). Per person per month, and everyone together.
    "OPERATORS": "vedu,jxn",
    // The developers' bug board: /api/bugs posts web + app bug reports there (jxn #3336). Set to the board's id
    // once it exists; while empty, the endpoint answers that bug reports aren't set up.
    "BUGS_BOARD": "b_tds5v873d8a7",
    // The north star (src/northStar.ts, vedu #5284): boards where 2+ outside people were active in a week. TEAM_USERS are
    // our own accounts, left out of it; every Monday from 16:00 UTC the week's line is posted to NORTH_STAR_BOARD.
    "TEAM_USERS": "vedu,jxn",
    "NORTH_STAR_BOARD": "b_skyvcqtm7fei",
    // Product analytics (vedu #4416, #4577): PostHog project 647810 "Atteo" (US). The project key is public by design (it can
    // only record events); src/analytics.ts sends event names and route tokens only, never text, emails or handles.
    "POSTHOG_KEY": "phc_wmSGccJEcjikTZXeXaReyTKJXxFKDXVifqBE8QpQdQy2",
    "POSTHOG_HOST": "us",
    "VOICE_MONTHLY_MINUTES": "60",
    "VOICE_GLOBAL_MONTHLY_MINUTES": "600",
    "TTS_MONTHLY_CHARS": "150000",
    "TTS_GLOBAL_MONTHLY_CHARS": "2000000"
  },
  // Staging (vedu #6570; docs/STAGING.md): `scripts/staging.sh` deploys the current checkout here with --env staging. Plain
  // `wrangler deploy` (ship.sh) still deploys only the top level above, i.e. prod. Wrangler does not inherit bindings or
  // vars into an env, so everything the Worker binds is restated here, pointing at staging-only resources: its own D1, its
  // own Durable Object namespaces (per Worker), its own rate-limit counter, and no backup bucket. No prod var that names
  // a prod board, analytics project or sign-in app. The one cron stays: with none of the backup, email, cost-guard or
  // north-star settings here it only runs housekeeping on staging's own data.
  "env": {
    "staging": {
      "name": "atteo-staging",
      "workers_dev": true,
      "preview_urls": false,
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "assets": { "directory": "./public", "binding": "ASSETS", "html_handling": "none", "not_found_handling": "none", "run_worker_first": true },
      "durable_objects": {
        "bindings": [{ "name": "BOARD", "class_name": "Board" }, { "name": "SLACK", "class_name": "SlackTeam" }, { "name": "MAILBOX_SIGNAL", "class_name": "MailboxSignal" }]
      },
      "ratelimits": [{ "name": "PUBLIC_WRITES", "namespace_id": "6570", "simple": { "limit": 20, "period": 60 } }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "agent-board-staging",
          "database_id": "770fadc3-ab53-4bb3-aa3c-7232e151f2a1",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [], // backups off: no bucket, and no BACKUP_PUBLIC_KEY
      "vars": {
        "PUBLIC_URL": "https://atteo-staging.vedu-mallela.workers.dev",
        // Off here, stated as blanks: sign-in (prod's WorkOS app), the cost guard, calls, /_ops by email (ops go through
        // ADMIN_KEY), the bug and north-star boards (prod board ids) and analytics (prod's PostHog project).
        "WORKOS_CLIENT_ID": "",
        "CF_ACCOUNT_ID": "",
        "CF_REALTIME_APP_ID": "",
        "ADMIN_EMAIL": "",
        "BUGS_BOARD": "",
        "NORTH_STAR_BOARD": "",
        "POSTHOG_KEY": "",
        "POSTHOG_HOST": "",
        "OPERATORS": "vedu,jxn",
        "TEAM_USERS": "vedu,jxn",
        "VOICE_MONTHLY_MINUTES": "60",
        "VOICE_GLOBAL_MONTHLY_MINUTES": "600",
        "TTS_MONTHLY_CHARS": "150000",
        "TTS_GLOBAL_MONTHLY_CHARS": "2000000",
        // D1 read replicas (vedu #6581, src/replicas.ts): the hot board reads through a replica Session. Staging's
        // database has read replication on; prod's top level leaves this unset (off) until the security review.
        "D1_REPLICAS": "1",
        // x-d1-bookmark/x-d1-served on the hot GETs (they name the region and colo): staging only, never prod's vars.
        "D1_DEBUG_HEADERS": "1"
      }
      // Secrets (wrangler secret put X --env staging): ADMIN_KEY only, a fresh random value staging.sh makes. Never a prod
      // secret: no WORKOS_*, RESEND_*, SENTRY_DSN, STRIPE_*, BACKUP_* or integration keys, so sign-in, email, error
      // reporting, payments, backups and integrations are all off here.
    }
  }
  // Secrets (wrangler secret put): WORKOS_API_KEY, ADMIN_KEY, SENTRY_DSN, XAI_API_KEY (read aloud and voice; without it /api/app/tts and /api/app/voice/session answer 503). Optional GitHub App: GITHUB_WEBHOOK_SECRET (POST /github/webhook); GITHUB_APP_ID, GITHUB_APP_PRIVATE_KEY, optional GITHUB_APP_INSTALLATION_ID for outbound Checks (docs/github-app.md). Never put App credentials in vars — hosted production leaves them unset. Optional product analytics (docs/ANALYTICS.md): POSTHOG_KEY (public project API key, phc_…) and POSTHOG_HOST ("eu" or "us"; default eu). Unset: the web loader does nothing. Locally they come from .dev.vars.
}
