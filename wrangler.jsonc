{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-board",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_als"], // Sentry keeps per-request context with AsyncLocalStorage
  "observability": { "enabled": true },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "workers_dev": true,
  "preview_urls": false,
  "triggers": { "crons": ["*/5 * * * *"] },
  // The agent skill (skills/atteo/SKILL.md) is bundled as text and served at /skill.md.
  "rules": [{ "type": "Text", "globs": ["**/*.md", "**/atteo.mjs"], "fallthrough": true }, { "type": "Data", "globs": ["**/*.woff2"], "fallthrough": true }],
  // The CLI is bundled into one file and served at /cli/atteo.mjs (curl …/install.sh | sh installs it).
  "build": { "command": "npm run -s build:cli" },
  "durable_objects": {
    "bindings": [{ "name": "BOARD", "class_name": "Board" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Board"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-board",
      "database_id": "74f82c17-1d1f-481f-8122-42c81de3342e",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "WORKOS_CLIENT_ID": "client_01M3XKJWX8TW7YAMPZVJZFJYHT",
    "ADMIN_EMAIL": "vedu.mallela@gmail.com,jxn@blxmail.com",
    // The public address (proxied to this workers.dev Worker from another account): sign-in callback, emails, OAuth/A2A
    // metadata, install.sh and webhook links all point here. Requests to localhost keep their own origin (src/util.ts publicOrigin).
    "PUBLIC_URL": "https://atteo.dev",
    // Voice + read-aloud caps (vedu #1582: strict; #1584: operators exempt). Per person per month, and everyone together.
    "OPERATORS": "vedu,jxn",
    // The developers' bug board: /api/bugs posts web + app bug reports there (jxn #3336). Set to the board's id
    // once it exists; while empty, the endpoint answers that bug reports aren't set up.
    "BUGS_BOARD": "b_tds5v873d8a7",
    "VOICE_MONTHLY_MINUTES": "60",
    "VOICE_GLOBAL_MONTHLY_MINUTES": "600",
    "TTS_MONTHLY_CHARS": "150000",
    "TTS_GLOBAL_MONTHLY_CHARS": "2000000"
  }
  // Secrets (wrangler secret put): WORKOS_API_KEY, ADMIN_KEY, SENTRY_DSN, XAI_API_KEY (read aloud and voice; without it /api/app/tts and /api/app/voice/session answer 503). Locally they come from .dev.vars.
}
