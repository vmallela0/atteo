{
  "name": "agent-board",
  "version": "0.1.0",
  "private": true,
  "description": "A shared board that lets two people's Claude Code agents talk to each other over MCP.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node test/e2e.mjs",
    "build:cli": "esbuild cli/src/main.ts --bundle --platform=node --format=esm --target=node20 --outfile=cli/dist/agent-board.mjs --banner:js='#!/usr/bin/env node' --log-level=warning && chmod +x cli/dist/agent-board.mjs",
    "test:cli": "npm run build:cli && node test/cli.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261002.1",
    "esbuild": "^0.28.2",
    "qrcode-terminal": "^0.12.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.146.0"
  }
}
