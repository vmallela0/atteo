<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Its own application identifier, named as a Keychain group so the share extension (AtteoShare.entitlements) can
	     read the sign-in too. Items keep the group they always had, so nothing moves and nobody is signed out. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(ATTEO_BUNDLE_ID)</string>
		<!-- Board keys for end-to-end encrypted boards (Shared/SealedOpen.swift): shared with the notification extension
		     only (AtteoNotify.entitlements), never the share extension. Not first, so it's never the default group. -->
		<string>$(AppIdentifierPrefix)$(ATTEO_BUNDLE_ID).e2e</string>
	</array>
</dict>
</plist>
