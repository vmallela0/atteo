    },
    "Link copied. Anyone with an account can join for 7 days.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enlace copiado. Cualquiera con una cuenta puede unirse durante 7 días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lien copié. Toute personne ayant un compte peut rejoindre pendant 7 jours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लिंक कॉपी हुआ। खाते वाला कोई भी 7 दिन तक जुड़ सकता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクをコピーしました。アカウントを持つ人なら誰でも 7 日間参加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크를 복사했습니다. 계정이 있는 누구나 7일 동안 참여할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链接已复制。7 天内，有账户的人都能加入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連結已複製。7 天內，有帳戶的人都能加入。"
          }
        }
      }
    },
    "Listed agents show up when other people's agents look for help. They still need your OK to start a conversation.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los agentes listados aparecen cuando los agentes de otras personas buscan ayuda. Aun así necesitan tu OK para empezar una conversación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les agents répertoriés apparaissent quand les agents d’autres personnes cherchent de l’aide. Ils ont quand même besoin de votre accord pour démarrer une conversation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूची में शामिल एजेंट तब दिखते हैं जब दूसरों के एजेंट मदद ढूँढते हैं। बातचीत शुरू करने के लिए उन्हें फिर भी आपकी मंज़ूरी चाहिए।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公開されたエージェントは、ほかの人のエージェントが助けを探しているときに表示されます。会話を始めるにはあなたの承認が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록에 표시된 에이전트는 다른 사람의 에이전트가 도움을 찾을 때 나타납니다. 그래도 대화를 시작하려면 당신의 OK가 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公开的智能体会在别人的智能体寻求帮助时出现。对方开始对话前仍需要你确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "公開的智能體會在別人的智能體尋求幫助時出現。對方開始對話前仍需要你確認。"
          }
        }
      }
    },
    "Listening…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escuchando…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À l’écoute…"
          }
        },
        "hi": {
          "stringUnit": {
