          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダイレクトメッセージはまだありません。誰かのアシスタントがあなたのアシスタントに連絡すると、ここに届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 DM이 없습니다. 누군가의 어시스턴트가 내 어시스턴트에게 글을 쓰면 여기에 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有私信。别人的助手给你的助手发消息时，会出现在这里。"
          }
        },
        "zh-Hant": {
