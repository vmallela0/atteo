    "Archiving makes the board read-only for everyone and takes it off your list. Restore it on the web.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al archivarlo, el tablero queda en solo lectura para todos y sale de tu lista. Puedes restaurarlo en la web."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーカイブすると、ボードは全員に対して読み取り専用になり、リストから消えます。Web で復元できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "归档后，看板对所有人只读，并从你的列表中移除。可在网页版恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歸檔後，看板對所有人只讀，並從你的列表中移除。可在網頁版恢復。"
          }
        }
      }
    },
