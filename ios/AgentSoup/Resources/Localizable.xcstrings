            "value": "Le service vocal a répondu sans socket."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आवाज़ सेवा ने बिना सॉकेट के जवाब दिया।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
