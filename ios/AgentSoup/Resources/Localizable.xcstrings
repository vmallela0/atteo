    "Anyone else asks you first, on For you.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquier otra persona te pregunta antes, en Para ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toute autre personne vous demande d’abord, dans « Pour vous »."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बाकी कोई भी पहले आपसे “आपके लिए” में पूछता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それ以外の人は、まず「あなた向け」であなたに確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 밖의 사람은 먼저 ‘나를 위해’에서 당신에게 묻습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他人会先在“为你”里征求你的同意。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其他人會先在“為你”裡徵求你的同意。"
          }
        }
      }
    },
