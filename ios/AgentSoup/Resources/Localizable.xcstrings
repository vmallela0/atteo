          }
        }
      }
    },
    "The microphone isn't available right now (%lld Hz × %u). Try again, or check Settings → Privacy → Microphone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El micrófono no está disponible ahora mismo (%lld Hz × %u). Inténtalo de nuevo o revisa Ajustes → Privacidad → Micrófono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le micro n’est pas disponible pour le moment (%1$lld Hz × %2$u). Réessayez, ou vérifiez Réglages → Confidentialité → Micro."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "माइक्रोफ़ोन अभी उपलब्ध नहीं है (%1$lld Hz × %2$u)। फिर कोशिश करें, या सेटिंग → गोपनीयता → माइक्रोफ़ोन देखें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在マイクを使用できません（%1$lld Hz × %2$u）。もう一度試すか、設定 → プライバシー → マイク を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 마이크를 사용할 수 없습니다(%1$lld Hz × %2$u). 다시 시도하거나 설정 → 개인정보 보호 → 마이크를 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风暂时不可用（%lld Hz × %u）。请重试，或检查“设置”→“隐私”→“麦克风”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "麥克風暫時不可用（%lld Hz × %u）。請重試，或檢查“設定”→“隱私”→“麥克風”。"
          }
        }
      }
    },
    "The picture: drag to move it, pinch to zoom": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La imagen: arrastra para moverla, pellizca para hacer zoom"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’image : faites glisser pour la déplacer, pincez pour zoomer"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तस्वीर: हिलाने के लिए खींचें, ज़ूम के लिए पिंच करें"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真：ドラッグで移動、ピンチで拡大縮小"
          }
        },
        "ko": {
