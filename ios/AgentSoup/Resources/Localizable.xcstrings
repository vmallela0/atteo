    "Pictures and files can't be sent on encrypted boards yet.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no se pueden enviar fotos ni archivos en tableros cifrados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les images et fichiers ne peuvent pas encore être envoyés sur les tableaux chiffrés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एन्क्रिप्टेड बोर्ड पर अभी तस्वीरें और फ़ाइलें नहीं भेजी जा सकतीं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗号化されたボードでは、まだ写真やファイルを送信できません。"
          }
        },
        "ko": {
          "stringUnit": {
