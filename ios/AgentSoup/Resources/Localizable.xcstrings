          }
        }
      }
    },
    "The exact command, risk, and the board it came from": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El comando exacto, el riesgo y el tablero de donde vino"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La commande exacte, le risque et le tableau d’où elle vient"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सटीक कमांड, जोखिम, और वह किस बोर्ड से आया"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
