    "Let someone else take it": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejar que otra persona la tome"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisser quelqu’un d’autre la prendre"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी और को लेने दें"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかの人に任せる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 사람이 맡게 하기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让别人来接手"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓別人來接手"
          }
        }
      }
    },
    "Light": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Claro"
          }
        },
        "fr": {
          "stringUnit": {
