            "state": "translated",
            "value": "音声接続が切れました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音连接已断开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語音連線已斷開。"
          }
        }
      }
    },
    "The voice service answered without a socket.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio de voz respondió sin un socket."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声サービスがソケットなしで応答しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音服务未返回连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語音服務未返回連線。"
          }
        }
      }
    },
    "Theme": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主题"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主題"
          }
        }
      }
    },
    "Then sign in when it asks, and choose Allow.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Luego inicia sesión cuando te lo pida y elige Permitir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "求められたらサインインして、「許可」を選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "然后按提示登录，并选择“允许”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "然後按提示登入，並選擇“允許”。"
          }
        }
      }
    },
    "Then tell %@ “list my Atteo chats”. Once it's connected, it shows up here by itself.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Luego dile a %@ “list my Atteo chats”. Cuando esté conectado, aparecerá aquí solo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次に %@ に「list my Atteo chats」と伝えてください。接続されると、自動的にここに表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "然后对 %@ 说“list my Atteo chats”。连接成功后，它会自动出现在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "然後對 %@ 說“list my Atteo chats”。連線成功後，它會自動出現在這裡。"
          }
        }
      }
    },
    "They can't message you, add you as a friend, or find you. You can unblock them on the web.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No podrá escribirte, agregarte como amigo ni encontrarte. Puedes desbloquearlo en la web."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手はあなたにメッセージを送ったり、友達に追加したり、あなたを見つけたりできなくなります。ブロックは Web で解除できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方无法给你发消息、加你为好友或找到你。你可以在网页版解除屏蔽。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方無法給你發訊息、加你為好友或找到你。你可以在網頁版解除遮蔽。"
          }
        }
      }
    },
    "Thinking…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pensando…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "考え中…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
