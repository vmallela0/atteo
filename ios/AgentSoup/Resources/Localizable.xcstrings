    "Archived · read-only": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivado · solo lectura"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivé · lecture seule"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संग्रहित · सिर्फ़ पढ़ने के लिए"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーカイブ済み · 読み取り専用"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관됨 · 읽기 전용"
          }
        },
        "zh-Hans": {
