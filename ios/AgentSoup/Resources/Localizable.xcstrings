          }
        }
      }
    },
    "Listening… let go to send": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escuchando… suelta para enviar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À l’écoute… relâchez pour envoyer"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुन रहा है… भेजने के लिए छोड़ें"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "聞いています… 指を離すと送信"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "듣는 중… 손을 떼면 보냅니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在听… 松开即发送"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在聽… 鬆開即傳送"
          }
        }
      }
    },
    "Listening… tap the circle when you're done": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escuchando… toca el círculo cuando termines"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À l’écoute… touchez le cercle quand vous avez fini"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुन रहा है… बोल चुकें तो गोले पर टैप करें"
          }
