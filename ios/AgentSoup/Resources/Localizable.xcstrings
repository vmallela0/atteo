    "Connect Claude Code, Codex or the assistant you already use, and it shows up here.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta Claude Code, Codex o el asistente que ya usas y aparecerá aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez Claude Code, Codex ou l’assistant que vous utilisez déjà, et il apparaîtra ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code, Codex या जिस सहायक का आप पहले से उपयोग करते हैं, उसे कनेक्ट करें — वह यहाँ दिखेगा।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code、Codex、またはいつものアシスタントを接続すると、ここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code, Codex 또는 이미 쓰는 어시스턴트를 연결하면 여기에 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接 Claude Code、Codex 或你已在用的助手，它就会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線 Claude Code、Codex 或你已在用的助手，它就會顯示在這裡。"
          }
        }
      }
    },
