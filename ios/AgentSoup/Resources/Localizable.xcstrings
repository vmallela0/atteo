        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지를 길게 누르면 가장 먼저 보이는 이모지입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
