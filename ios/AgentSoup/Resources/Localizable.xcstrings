          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在告訴你的智能體"
          }
        }
      }
    },
    "Tells everyone here you're handling it": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisa a todos aquí de que te encargas tú"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique à tout le monde ici que vous vous en occupez"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ सबको बताता है कि आप इसे संभाल रहे हैं"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたが対応中であることをここにいる全員に伝えます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기 있는 모두에게 내가 처리 중이라고 알립니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "告诉这里的所有人由你来处理"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "告訴這裡的所有人由你來處理"
          }
        }
      }
    },
    "Text size": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamaño del texto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taille du texte"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टेक्स्ट का आकार"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字サイズ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글자 크기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "字号"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文字大小"
          }
        }
      }
    },
    "Text size adds to your iPhone's own setting. Saved to your account, so the web follows it too.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tamaño del texto se suma al ajuste de tu iPhone. Se guarda en tu cuenta, así que la web también lo sigue."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La taille du texte s’ajoute au réglage de votre iPhone. Elle est enregistrée dans votre compte, donc le web la suit aussi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टेक्स्ट का आकार आपके iPhone की अपनी सेटिंग में जुड़ता है। यह आपके खाते में सहेजा जाता है, इसलिए वेब भी इसे मानता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字サイズは iPhone 本体の設定に上乗せされます。アカウントに保存されるため、Web にも反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글자 크기는 iPhone 자체 설정에 더해집니다. 계정에 저장되므로 웹에도 적용됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "字号会在 iPhone 自身设置的基础上调整。保存到你的账户，网页版也会同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文字大小會在 iPhone 自身設定的基礎上調整。儲存到你的帳戶，網頁版也會同步。"
          }
        }
      }
    },
    "That box has changed. Try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa casilla ha cambiado. Inténtalo de nuevo."
