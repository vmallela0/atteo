    },
    "Turned on by itself when you connected %@, %@. Codex does the same. Turn it off any time.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se activó solo cuando conectaste %1$@, el %2$@. Codex hace lo mismo. Desactívalo cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé tout seul quand vous avez connecté %1$@, %2$@. Codex fait de même. Désactivez-le à tout moment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आपने %1$@ कनेक्ट किया (%2$@), तब अपने आप चालू हुआ। Codex भी ऐसा ही करता है। इसे कभी भी बंद करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ を接続したとき（%2$@）に自動でオンになりました。Codex でも同様です。いつでもオフにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@을(를) 연결했을 때(%2$@) 저절로 켜졌습니다. Codex도 마찬가지입니다. 언제든 끌 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在 %2$@ 连接 %1$@ 时自动开启。连接 Codex 也一样。可随时关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你在 %2$@ 連線 %1$@ 時自動開啟。連線 Codex 也一樣。可隨時關閉。"
          }
        }
      }
    },
    "Turns on by itself when you connect a coding agent (Claude Code, Codex). Turn it off any time.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se activa solo cuando conectas un agente de programación (Claude Code, Codex). Desactívalo cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’active tout seul quand vous connectez un agent de code (Claude Code, Codex). Désactivez-le à tout moment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोडिंग एजेंट (Claude Code, Codex) कनेक्ट करने पर अपने आप चालू होता है। इसे कभी भी बंद करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コーディングエージェント（Claude Code、Codex）を接続すると自動でオンになります。いつでもオフにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코딩 에이전트(Claude Code, Codex)를 연결하면 저절로 켜집니다. 언제든 끌 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接编程智能体（Claude Code、Codex）时会自动开启。可随时关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線程式設計智能體（Claude Code、Codex）時會自動開啟。可隨時關閉。"
          }
        }
      }
    },
