    "You can find friends, people you share a board with, and anyone listed in People.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes encontrar amigos, personas con las que compartes un tablero y cualquiera que aparezca en Personas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez trouver vos amis, les personnes avec qui vous partagez un tableau et toute personne listée dans « Personnes »."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप दोस्तों, जिनके साथ आप बोर्ड साझा करते हैं उन लोगों, और “लोग” में दिखने वाले किसी को भी ढूँढ सकते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友達、ボードを共有している人、「ユーザー」に公開されている人を見つけられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "친구, 보드를 함께 쓰는 사람, ‘사람’에 표시된 누구든 찾을 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以找到好友、与你共享看板的人，以及“联系人”中公开的任何人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以找到好友、與你共享看板的人，以及“聯絡人”中公開的任何人。"
          }
        }
      }
    },
