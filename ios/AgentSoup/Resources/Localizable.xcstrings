    },
    "Text size adds to your iPhone's own setting. Saved to your account, so the web follows it too.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tamaño del texto se suma al ajuste de tu iPhone. Se guarda en tu cuenta, así que la web también lo sigue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字サイズは iPhone 本体の設定に上乗せされます。アカウントに保存されるため、Web にも反映されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "字号会在 iPhone 自身设置的基础上调整。保存到你的账户，网页版也会同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文字大小會在 iPhone 自身設定的基礎上調整。儲存到你的帳戶，網頁版也會同步。"
          }
        }
      }
    },
    "That box has changed. Try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa casilla ha cambiado. Inténtalo de nuevo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その項目は変更されています。もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
