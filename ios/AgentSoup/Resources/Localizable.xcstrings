        }
      }
    },
    "Invited %@.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitaste a %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitation envoyée à %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को आमंत्रित किया।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を招待しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 님을 초대했습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已邀请 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已邀請 %@。"
          }
        }
      }
    },
    "It asks you before it pays, books, sends something for you, or shares a file.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te pregunta antes de pagar, reservar, enviar algo por ti o compartir un archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il vous demande avant de payer, de réserver, d’envoyer quelque chose pour vous ou de partager un fichier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भुगतान करने, बुकिंग करने, आपकी ओर से कुछ भेजने या फ़ाइल साझा करने से पहले यह आपसे पूछता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支払い、予約、あなたに代わっての送信、ファイルの共有の前には、必ずあなたに確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결제하거나, 예약하거나, 당신 대신 무언가를 보내거나, 파일을 공유하기 전에 먼저 당신에게 묻습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它在付款、预订、替你发送内容或分享文件之前，都会先问你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它在付款、預訂、替你傳送內容或分享檔案之前，都會先問你。"
          }
        }
      }
    },
    "It becomes read-only for everyone. You can restore it on the web.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Queda en solo lectura para todos. Puedes restaurarlo en la web."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il passe en lecture seule pour tout le monde. Vous pouvez le restaurer sur le web."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सबके लिए सिर्फ़ पढ़ने के लिए हो जाता है। आप इसे वेब पर बहाल कर सकते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全員に対して読み取り専用になります。Web で復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 사람에게 읽기 전용이 됩니다. 웹에서 복원할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它将对所有人只读。可在网页版恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它將對所有人只讀。可在網頁版恢復。"
          }
        }
      }
    },
    "It comes off the task board for everyone. The conversation keeps a note that it was removed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sale del tablero de tareas para todos. La conversación conserva una nota de que se quitó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle disparaît du tableau des tâches pour tout le monde. La conversation garde une note indiquant qu’elle a été retirée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सबके कार्य बोर्ड से हट जाता है। बातचीत में एक नोट रहता है कि इसे हटाया गया।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全員のタスクボードから外れます。会話には削除されたことが記録されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 사람의 작업 보드에서 빠집니다. 대화에는 제거되었다는 기록이 남습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它会从所有人的任务看板上移除，对话中会留下一条已移除的记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它會從所有人的任務看板上移除，對話中會留下一條已移除的記錄。"
          }
        }
      }
    },
    "It leaves your Chats. Someone here can add you back.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sale de tus Chats. Alguien de aquí puede volver a añadirte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il disparaît de vos Chats. Quelqu’un ici peut vous rajouter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आपकी चैट से हट जाती है। यहाँ कोई भी आपको फिर से जोड़ सकता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットから外れます。ここにいる人があなたを再び追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 채팅에서 사라집니다. 여기 있는 누군가가 다시 추가할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它会从你的聊天列表中移除。这里的成员可以再把你加回来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它會從你的聊天列表中移除。這裡的成員可以再把你加回來。"
          }
        }
      }
    },
    "It may have been removed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que se haya eliminado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il a peut-être été supprimé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शायद इसे हटा दिया गया है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除された可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제되었을 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它可能已被移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它可能已被移除。"
          }
        }
      }
    },
    "It's how people and agents @mention you on every board.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Así es como las personas y los agentes te @mencionan en todos los tableros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est ainsi que les personnes et les agents vous @mentionnent sur tous les tableaux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर बोर्ड पर लोग और एजेंट इसी से आपका @ज़िक्र करते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのボードでも、人やエージェントはこの名前であなたを @メンションします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 보드에서 사람과 에이전트가 이 이름으로 당신을 @멘션합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大家和智能体在各个看板上用它来 @提及 你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "大家和智能體在各個看板上用它來 @提及 你。"
          }
        }
      }
    },
    "It's live.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya está activo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est en ligne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह लाइव है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公開されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공개되었습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已上线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已上線。"
          }
        }
      }
    },
    "Join %@ on Atteo": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Únete a %@ en Atteo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejoignez %@ sur Atteo"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Atteo पर %@ से जुड़ें"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Atteo で %@ に参加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Atteo에서 %@에 참여하세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Atteo 上加入 %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Atteo 上加入 %@"
          }
        }
      }
    },
    "Jump to latest": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ir a lo más reciente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aller au plus récent"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नवीनतम पर जाएँ"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新へ移動"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최신으로"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跳到最新"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "跳到最新"
          }
        }
      }
    },
    "Just mine": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo yo"
          }
