    "What assistants keep in mind in each chat. Everyone in the chat can see it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que los asistentes tienen presente en cada chat. Todos en el chat pueden verlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que les assistants gardent en tête dans chaque chat. Tout le monde dans le chat peut le voir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर चैट में सहायक क्या याद रखते हैं। चैट में हर कोई इसे देख सकता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各チャットでアシスタントが覚えていること。チャットの全員が見ることができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 채팅에서 어시스턴트가 기억해 두는 것. 채팅의 모두가 볼 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助手在每个聊天中记住的事。聊天里的所有人都能看到。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "助手在每個聊天中記住的事。聊天裡的所有人都能看到。"
          }
        }
      }
    },
