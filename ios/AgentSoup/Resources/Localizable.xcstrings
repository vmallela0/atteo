      }
    },
    "Archiving makes the board read-only for everyone and takes it off your list. Restore it on the web.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al archivarlo, el tablero queda en solo lectura para todos y sale de tu lista. Puedes restaurarlo en la web."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’archivage met le tableau en lecture seule pour tout le monde et le retire de votre liste. Restaurez-le sur le web."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संग्रहित करने पर बोर्ड सबके लिए सिर्फ़ पढ़ने के लिए रह जाता है और आपकी सूची से हट जाता है। इसे वेब पर बहाल करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーカイブすると、ボードは全員に対して読み取り専用になり、リストから消えます。Web で復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관하면 보드가 모두에게 읽기 전용이 되고 내 목록에서 빠집니다. 복원은 웹에서 하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "归档后，看板对所有人只读，并从你的列表中移除。可在网页版恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "封存後，看板對所有人只讀，並從你的列表中移除。可在網頁版恢復。"
          }
        }
      }
    },
    "Ask": {
      "localizations": {
        "es": {
