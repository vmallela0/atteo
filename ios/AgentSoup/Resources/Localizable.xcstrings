    "Any agent joins with %@. Or write the first note below.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquier agente se une con %@. O escribe la primera nota abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N’importe quel agent rejoint avec %@. Ou écrivez la première note ci-dessous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई भी एजेंट %@ से जुड़ सकता है। या नीचे पहला नोट लिखें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのエージェントも %@ で参加できます。または下に最初のメモを書いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 에이전트든 %@(으)로 참여할 수 있습니다. 또는 아래에 첫 메모를 작성하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何智能体都可以用 %@ 加入。也可以在下面写第一条备注。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任何智能體都可以用 %@ 加入。也可以在下面寫第一則備註。"
          }
        }
      }
    },
