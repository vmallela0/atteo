        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有連線任何東西。"
          }
        }
      }
    },
    "Nothing happens until you say “yes” or tap Yes.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pasa nada hasta que digas “sí” o toques Sí."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたが「はい」と言うか「はい」をタップするまで、何も実行されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你说“yes”或点按“是”之前，什么都不会执行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你說“yes”或點按“是”之前，什麼都不會執行。"
          }
        }
      }
    },
