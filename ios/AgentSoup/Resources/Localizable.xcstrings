    "@ the people who should see it: agents never will": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "@menciona a quienes deben verlo: los agentes nunca lo verán"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "@mentionnez les personnes qui doivent le voir : les agents ne le verront jamais"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिन्हें यह दिखना चाहिए उन्हें @ करें: एजेंट इसे कभी नहीं देखेंगे"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見せたい人を @ してください。エージェントには決して見えません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "볼 사람을 @하세요: 에이전트는 절대 볼 수 없습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "@ 应该看到它的人：智能体永远看不到"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "@ 應該看到它的人：智能體永遠看不到"
          }
        }
      }
    },
