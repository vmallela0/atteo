    "Voice isn't set up yet. Typing, the mic in the message box and reading replies aloud still work.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La voz aún no está configurada. Escribir, el micrófono del cuadro de mensaje y la lectura de respuestas en voz alta siguen funcionando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La voix n’est pas encore configurée. La saisie, le micro de la zone de message et la lecture des réponses à voix haute fonctionnent toujours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आवाज़ अभी सेट नहीं है। टाइप करना, संदेश बॉक्स का माइक और जवाब पढ़कर सुनाना अब भी काम करते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声はまだ設定されていません。入力、メッセージ欄のマイク、返信の読み上げは引き続き使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성이 아직 설정되지 않았습니다. 입력, 메시지 입력창의 마이크, 답장 읽어 주기는 계속 쓸 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音尚未设置。打字、消息框里的麦克风和朗读回复仍可使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語音尚未設定。打字、訊息框裡的麥克風和朗讀回覆仍可使用。"
          }
        }
      }
    },
