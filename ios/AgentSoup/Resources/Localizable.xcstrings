            "value": "나만"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅自己"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅自己"
          }
        }
      }
    },
    "Just mine · only you and your agents": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo yo · solo tú y tus agentes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien que moi · seulement vous et vos agents"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ मैं · सिर्फ़ आप और आपके एजेंट"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分だけ · あなたとあなたのエージェントだけ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나만 · 나와 내 에이전트만"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅自己 · 只有你和你的智能体"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅自己 · 只有你和你的智能體"
          }
        }
      }
    },
    "Just talk. Ask about %@, what's waiting for you, or tell your agent something.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo habla. Pregunta por %@, qué tienes pendiente o dile algo a tu agente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parlez, tout simplement. Posez des questions sur %@, sur ce qui vous attend, ou dites quelque chose à votre agent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बस बोलें। %@ के बारे में पूछें, पूछें कि क्या आपका इंतज़ार कर रहा है, या अपने एजेंट को कुछ बताएँ।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話しかけるだけ。%@ のこと、あなたを待っているもののことを聞いたり、エージェントに何か伝えたりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그냥 말하세요. %@에 대해서나 당신을 기다리는 일을 묻거나, 에이전트에게 무언가 전하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接说吧。可以问 %@ 的情况、有什么在等你，或者给你的智能体捎句话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接說吧。可以問 %@ 的情況、有什麼在等你，或者給你的智能體捎句話。"
          }
        }
      }
    },
    "Just talk. Ask what's waiting for you, catch up on a board, or tell your agent something.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo habla. Pregunta qué tienes pendiente, ponte al día con un tablero o dile algo a tu agente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parlez, tout simplement. Demandez ce qui vous attend, faites le point sur un tableau, ou dites quelque chose à votre agent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बस बोलें। पूछें कि क्या आपका इंतज़ार कर रहा है, किसी बोर्ड की ताज़ा जानकारी लें, या अपने एजेंट को कुछ बताएँ।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話しかけるだけ。あなたを待っているものを聞いたり、ボードの最新情報を確認したり、エージェントに何か伝えたりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그냥 말하세요. 당신을 기다리는 일을 묻거나, 보드의 새 소식을 확인하거나, 에이전트에게 무언가 전하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接说吧。可以问有什么在等你、回顾一个看板，或者给你的智能体捎句话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接說吧。可以問有什麼在等你、回顧一個看板，或者給你的智能體捎句話。"
          }
        }
      }
    },
    "Just talk: Atteo answers when you pause. Talk over it, or tap here, to stop it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo habla: Atteo responde cuando haces una pausa. Habla encima o toca aquí para detenerlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parlez, tout simplement : Atteo répond quand vous faites une pause. Parlez par-dessus, ou touchez ici, pour l’arrêter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बस बोलें: आपके रुकने पर Atteo जवाब देता है। उसे रोकने के लिए बीच में बोलें, या यहाँ टैप करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話しかけるだけ：あなたが話し終えると Atteo が答えます。止めるには、話しかけるかここをタップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그냥 말하세요: 말을 멈추면 Atteo가 답합니다. 멈추려면 끼어들어 말하거나 여기를 누르세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接说：你停顿时 Atteo 就会回答。直接插话或点按这里即可打断。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接說：你停頓時 Atteo 就會回答。直接插話或點按這裡即可打斷。"
          }
        }
      }
    },
