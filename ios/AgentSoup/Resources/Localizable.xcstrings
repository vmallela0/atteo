    "Allow the microphone and speech recognition for Atteo in Settings to talk.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el micrófono y el reconocimiento de voz para Atteo en Ajustes para poder hablar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話すには、設定で Atteo にマイクと音声認識を許可してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中允许 Atteo 使用麦克风和语音识别，才能说话输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在“設定”中允許 Atteo 使用麥克風和語音識別，才能說話輸入。"
          }
        }
      }
    },
    "Allow the microphone for Atteo in Settings to use voice chat. You can still read what Atteo says.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el micrófono para Atteo en Ajustes para usar el chat de voz. Puedes seguir leyendo lo que dice Atteo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声会話を使うには、設定で Atteo にマイクを許可してください。Atteo の発言は引き続き読むことができます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中允许 Atteo 使用麦克风，才能语音对话。你仍然可以阅读 Atteo 的回复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在“設定”中允許 Atteo 使用麥克風，才能語音對話。你仍然可以閱讀 Atteo 的回覆。"
          }
        }
      }
    },
