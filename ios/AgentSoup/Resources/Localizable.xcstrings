            "state": "translated",
            "value": "刪除“%@”？"
          }
        }
      }
    },
    "Deletes this chat for everyone. You can restore it for 30 days.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina este chat para todos. Puedes restaurarlo durante 30 días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime ce chat pour tout le monde. Vous pouvez le restaurer pendant 30 jours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह चैट सबके लिए हट जाएगी। आप इसे 30 दिन तक बहाल कर सकते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチャットを全員に対して削除します。30 日以内なら復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 채팅이 모든 사람에게서 삭제됩니다. 30일 동안 복원할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会为所有人删除这个聊天。30 天内可以恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會為所有人刪除這個聊天。30 天內可以恢復。"
          }
        }
      }
    },
    "Deleting isn't available on this server yet.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar aún no está disponible en este servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression n’est pas encore disponible sur ce serveur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस सर्वर पर अभी हटाने की सुविधा नहीं है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバではまだ削除できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 서버에서는 아직 삭제할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个服务器暂不支持删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個伺服器暫不支援刪除。"
          }
        }
      }
    },
