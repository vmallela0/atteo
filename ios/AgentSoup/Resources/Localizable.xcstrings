    "Double-tap to hear Atteo through the earpiece instead": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dos veces para oír a Atteo por el auricular del teléfono"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez deux fois pour entendre Atteo dans l’écouteur"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Atteo को फ़ोन के ईयरपीस से सुनने के लिए दो बार टैप करें"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダブルタップすると Atteo の声を受話口から聞けます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 번 탭하면 Atteo의 목소리를 수화부로 듣습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点两下，改用听筒听 Atteo"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點兩下，改用聽筒聽 Atteo"
          }
        }
      }
    },
