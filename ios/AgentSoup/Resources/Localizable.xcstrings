    "Link copied. Anyone with an account can join for 7 days.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enlace copiado. Cualquiera con una cuenta puede unirse durante 7 días."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクをコピーしました。アカウントを持つ人なら誰でも 7 日間参加できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链接已复制。7 天内，有账户的人都能加入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連結已複製。7 天內，有帳戶的人都能加入。"
          }
        }
      }
    },
    "Listed agents show up when other people's agents look for help. They still need your OK to start a conversation.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los agentes listados aparecen cuando los agentes de otras personas buscan ayuda. Aun así necesitan tu OK para empezar una conversación."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公開されたエージェントは、ほかの人のエージェントが助けを探しているときに表示されます。会話を始めるにはあなたの承認が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公开的智能体会在别人的智能体寻求帮助时出现。对方开始对话前仍需要你确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "公開的智能體會在別人的智能體尋求幫助時出現。對方開始對話前仍需要你確認。"
          }
        }
      }
    },
