    },
    "The voice connection closed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión de voz se cerró."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion vocale a été fermée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आवाज़ कनेक्शन बंद हो गया।"
          }
        },
        "ja": {
