    "Listening… Atteo answers after a pause": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escuchando… Atteo responde tras una pausa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À l’écoute… Atteo répond après une pause"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुन रहा है… Atteo रुकने के बाद जवाब देगा"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "聞いています… 間があくと Atteo が答えます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "듣고 있어요… 잠시 멈추면 Atteo가 답해요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在听… 你停顿后 Atteo 会回答"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在聽… 你停頓後 Atteo 會回答"
          }
        }
      }
    },
    "Listening. Tap Done when you’re finished": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escuchando. Toca Listo cuando termines"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À l’écoute. Touchez Terminé quand vous avez fini"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुन रहा है। बात पूरी होने पर हो गया टैप करें"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "聞いています。話し終えたら完了をタップしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "듣고 있어요. 다 말했으면 완료를 탭하세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在听。说完后点“完成”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在聽。說完後點「完成」"
          }
        }
      }
    },
    "Your turn, Atteo": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu turno, Atteo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À toi, Atteo"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब तुम्हारी बारी, Atteo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どうぞ、Atteo"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 네 차례야, Atteo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该你了，Atteo"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "換你了，Atteo"
          }
        }
      }
    },
    "Sends what you said. Play or pause on your AirPods does the same.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía lo que dijiste. Reproducir o pausar en tus AirPods hace lo mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie ce que vous avez dit. Lecture ou pause sur vos AirPods fait de même."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने जो कहा, वह भेजता है। AirPods पर चलाएँ या रोकें भी यही करता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話した内容を送ります。AirPods の再生・一時停止でも同じです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말한 내용을 보내요. AirPods의 재생/일시정지도 같아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送你说的话。按 AirPods 的播放或暂停也一样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送你說的話。按 AirPods 的播放或暫停也一樣。"
          }
        }
      }
    },
