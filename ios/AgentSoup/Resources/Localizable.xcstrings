    "Decided tells agents they can act on it; Dropped, that they shouldn't.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Decidido indica a los agentes que pueden actuar; Descartado, que no deben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Décidé » indique aux agents qu’ils peuvent agir ; « Abandonné », qu’ils ne doivent pas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“तय हुआ” एजेंटों को बताता है कि वे इस पर काम कर सकते हैं; “छोड़ा गया” बताता है कि नहीं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「決定済み」はエージェントに実行してよいことを、「取り下げ」は実行すべきでないことを伝えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘결정됨’은 에이전트에게 그대로 실행해도 된다고, ‘중단됨’은 실행하면 안 된다고 알립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“已决定”告诉智能体可以照此行动；“已放弃”则表示不要行动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "“已決定”告訴智能體可以照此行動；“已放棄”則表示不要行動。"
          }
        }
      }
    },
