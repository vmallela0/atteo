    "Search by name. Friends can message each other directly.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca por nombre. Los amigos pueden escribirse directamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherchez par nom. Les amis peuvent s’écrire directement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नाम से खोजें। दोस्त एक-दूसरे को सीधे संदेश भेज सकते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前で検索。友達同士はダイレクトメッセージを送り合えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름으로 검색하세요. 친구끼리는 서로 직접 메시지를 보낼 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按名字搜索。好友之间可以直接发消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按名字搜尋。好友之間可以直接發訊息。"
          }
        }
      }
    },
