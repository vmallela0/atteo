    "On-device speech recognition isn't available for your language on this iPhone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reconocimiento de voz en el dispositivo no está disponible para tu idioma en este iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La reconnaissance vocale sur l’appareil n’est pas disponible pour votre langue sur cet iPhone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस iPhone पर आपकी भाषा के लिए डिवाइस पर बोली पहचानने की सुविधा उपलब्ध नहीं है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneでは、お使いの言語のオンデバイス音声認識を利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone에서는 사용 중인 언어의 기기 내 음성 인식을 사용할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 iPhone 上的本机语音识别暂不支持你的语言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 iPhone 上的本機語音識別暫不支援你的語言。"
          }
        }
      }
    },
