                  "value": "Nada te necesita. Tu asistente hizo %lld cosa hoy."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Nada te necesita. Tu asistente hizo %lld cosas hoy."
