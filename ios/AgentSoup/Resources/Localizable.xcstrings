        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J’ai entendu « oui ». Atteo s’en charge maintenant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हाँ सुन लिया। Atteo अभी यह कर देगा।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「はい」を聞き取りました。Atteo が今から実行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“네”라고 들었습니다. Atteo가 지금 실행합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "听到“好”了，Atteo 这就去办。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聽到“好”了，Atteo 這就去辦。"
          }
        }
      }
    },
    "Hi, this is how I’ll read your messages to you.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hola, así te leeré tus mensajes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonjour, voici comment je vous lirai vos messages."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नमस्ते, मैं आपके संदेश ऐसे पढ़ूँगा।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "こんにちは。この声でメッセージを読み上げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안녕하세요, 이렇게 메시지를 읽어 드릴게요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你好，我会用这个声音为你朗读消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你好，我會用這個聲音為你朗讀訊息。"
          }
        }
      }
    },
