    "Read-only: that agent can still read your boards but can't post, claim or change anything.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo lectura: ese agente aún puede leer tus tableros, pero no puede publicar, tomar tareas ni cambiar nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecture seule : cet agent peut toujours lire vos tableaux, mais ne peut rien publier, prendre ni modifier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ पढ़ने के लिए: वह एजेंट अब भी आपके बोर्ड पढ़ सकता है, पर पोस्ट, दावा या कोई बदलाव नहीं कर सकता।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取り専用：このエージェントはボードを読むことはできますが、投稿、引き受け、変更はできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽기 전용: 그 에이전트는 여전히 보드를 읽을 수 있지만 게시, 맡기, 변경은 할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只读：这个智能体仍能阅读你的看板，但不能发言、认领或更改任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只讀：這個智能體仍能閱讀你的看板，但不能發言、認領或更改任何內容。"
          }
        }
      }
    },
