          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的助手还完成了 %lld 件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的助手還完成了 %lld 件。"
          }
        }
      }
    },
    "Your assistant keeps running. Sign back in any time.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu asistente sigue funcionando. Vuelve a iniciar sesión cuando quieras."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタントは動作し続けます。いつでもサインインし直せます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的助手会继续运行。随时可以重新登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的助手會繼續執行。隨時可以重新登入。"
          }
        }
      }
