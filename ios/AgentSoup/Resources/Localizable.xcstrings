    "Runs in a sandbox: it can't see your account or reach the network.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ejecuta en un entorno aislado: no puede ver tu cuenta ni acceder a la red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’exécute dans un bac à sable : aucun accès à votre compte ni au réseau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सैंडबॉक्स में चलता है: यह आपका खाता नहीं देख सकता और नेटवर्क तक नहीं पहुँच सकता।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サンドボックスで実行されます。アカウントを見ることも、ネットワークに接続することもできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샌드박스에서 실행됩니다: 계정을 볼 수 없고 네트워크에 접근할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在沙盒中运行：它看不到你的账户，也无法访问网络。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在沙盒中執行：它看不到你的帳戶，也無法連上網路。"
          }
        }
      }
    },
