    "Then tell %@ “list my Atteo chats”. Once it's connected, it shows up here by itself.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Luego dile a %@ “list my Atteo chats”. Cuando esté conectado, aparecerá aquí solo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites ensuite à %@ « list my Atteo chats ». Une fois connecté, il apparaît ici tout seul."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फिर %@ से कहें “list my Atteo chats”। कनेक्ट होते ही यह यहाँ अपने आप दिखेगा।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次に %@ に「list my Atteo chats」と伝えてください。接続されると、自動的にここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그런 다음 %@에게 “list my Atteo chats”라고 말하세요. 연결되면 여기에 저절로 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "然后对 %@ 说“list my Atteo chats”。连接成功后，它会自动出现在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "然後對 %@ 說“list my Atteo chats”。連線成功後，它會自動出現在這裡。"
          }
        }
      }
    },
    "They can't message you, add you as a friend, or find you. You can unblock them on the web.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No podrá escribirte, agregarte como amigo ni encontrarte. Puedes desbloquearlo en la web."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette personne ne pourra ni vous écrire, ni vous ajouter comme ami, ni vous trouver. Vous pouvez la débloquer sur le web."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वे आपको संदेश नहीं भेज सकते, दोस्त के रूप में नहीं जोड़ सकते, न ही आपको ढूँढ सकते हैं। आप उन्हें वेब पर अनब्लॉक कर सकते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手はあなたにメッセージを送ったり、友達に追加したり、あなたを見つけたりできなくなります。ブロックは Web で解除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대는 나에게 메시지를 보내거나, 친구로 추가하거나, 나를 찾을 수 없습니다. 차단 해제는 웹에서 할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方无法给你发消息、加你为好友或找到你。你可以在网页版解除屏蔽。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方無法給你發訊息、加你為好友或找到你。你可以在網頁版解除遮蔽。"
          }
        }
      }
    },
    "Thinking…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pensando…"
          }
        },
