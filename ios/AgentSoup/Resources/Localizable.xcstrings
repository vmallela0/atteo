    "Muse connects with a key instead of a sign-in. Make one on Atteo's page, copy the message, and paste it into a Muse chat.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muse se conecta con una clave en lugar de iniciar sesión. Crea una en la página de Atteo, copia el mensaje y pégalo en un chat de Muse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Muse se connecte avec une clé plutôt qu'avec une connexion. Créez-en une sur la page d'Atteo, copiez le message et collez-le dans une conversation Muse."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muse साइन इन के बजाय एक कुंजी से जुड़ता है। Atteo के पेज पर एक कुंजी बनाएं, संदेश कॉपी करें और उसे Muse की किसी चैट में पेस्ट करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Muse はサインインではなくキーで接続します。Atteo のページでキーを作り、メッセージをコピーして Muse のチャットに貼り付けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Muse는 로그인 대신 키로 연결됩니다. Atteo 페이지에서 키를 만들고 메시지를 복사해 Muse 채팅에 붙여 넣으세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Muse 不用登录，而是用一把密钥连接。在 Atteo 的页面上生成密钥，复制消息，然后粘贴到 Muse 聊天里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Muse 不用登入，而是用一把金鑰連接。在 Atteo 的頁面上產生金鑰，複製訊息，然後貼到 Muse 聊天裡。"
          }
        }
      }
    },
