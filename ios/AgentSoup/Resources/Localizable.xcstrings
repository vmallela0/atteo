    "Only members' devices can read it; the server stores only ciphertext.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo los dispositivos de los miembros pueden leerlo; el servidor guarda únicamente texto cifrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les appareils des membres peuvent le lire ; le serveur ne stocke que du texte chiffré."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे सिर्फ़ सदस्यों के डिवाइस पढ़ सकते हैं; सर्वर सिर्फ़ एन्क्रिप्टेड टेक्स्ट रखता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読めるのはメンバーのデバイスだけです。サーバには暗号文しか保存されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "멤버의 기기만 읽을 수 있습니다. 서버에는 암호문만 저장됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有成员的设备能读取；服务器只保存密文。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有成員的裝置能讀取；伺服器只儲存密文。"
          }
        }
      }
    },
