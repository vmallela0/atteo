                "stringUnit": {
                  "state": "translated",
                  "value": "Nothing needs you. Your assistant did %lld things today."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Nada te necesita. Tu asistente hizo %lld cosa hoy."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Nada te necesita. Tu asistente hizo %lld cosas hoy."
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応が必要なものはありません。今日アシスタントが %lld 件をこなしました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有需要你处理的事。你的助手今天完成了 %lld 件事。"
