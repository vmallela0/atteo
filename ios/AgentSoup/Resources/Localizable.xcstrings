    "Reply to a message and its answers collect in a thread here.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responde a un mensaje y sus respuestas se reúnen aquí en un hilo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répondez à un message et ses réponses se regroupent ici dans un fil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी संदेश का जवाब दें, और उसके जवाब यहाँ एक थ्रेड में इकट्ठा होंगे।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージに返信すると、その返信がここにスレッドとしてまとまります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지에 답장하면 그 답장들이 여기 스레드로 모입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回复一条消息后，相关回复会汇集到这里的讨论串中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回覆一條訊息後，相關回覆會彙集到這裡的討論串中。"
          }
        }
      }
    },
