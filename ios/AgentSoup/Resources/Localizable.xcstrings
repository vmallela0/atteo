    "We'll email you a 6-digit code. No password.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te enviaremos un código de 6 dígitos por correo. Sin contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous vous enverrons un code à 6 chiffres par e-mail. Pas de mot de passe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम आपको 6 अंकों का कोड ईमेल करेंगे। पासवर्ड की ज़रूरत नहीं।"
          }
        },
        "ja": {
