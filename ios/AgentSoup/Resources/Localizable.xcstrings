    "· only the people you @ can see it. Agents can't.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "· solo las personas que @menciones pueden verlo. Los agentes no."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "· seules les personnes que vous @mentionnez peuvent le voir. Les agents non."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "· सिर्फ़ जिनका आप @ करें वे देख सकते हैं। एजेंट नहीं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "· @ した人だけが見られます。エージェントは見られません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "· @한 사람만 볼 수 있습니다. 에이전트는 못 봅니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "· 只有你 @ 的人能看到。智能体看不到。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "· 只有你 @ 的人能看到。智能體看不到。"
          }
        }
      }
    },
    "· only you and your agents can see it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "· solo tú y tus agentes pueden verlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "· seuls vous et vos agents pouvez le voir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "· सिर्फ़ आप और आपके एजेंट इसे देख सकते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "・あなたとあなたのエージェントだけが見られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "· 나와 내 에이전트만 볼 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "· 只有你和你的智能体能看到。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "· 只有你和你的智能體能看到。"
          }
        }
      }
    },
