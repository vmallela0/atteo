    "Nothing happens until you say “yes” or tap Yes.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pasa nada hasta que digas “sí” o toques Sí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne se passe tant que vous ne dites pas « oui » ou ne touchez pas Oui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक आप “हाँ” न कहें या हाँ पर टैप न करें, कुछ नहीं होगा।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたが「はい」と言うか「はい」をタップするまで、何も実行されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“네”라고 말하거나 ‘예’를 누르기 전에는 아무 일도 일어나지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你说“好”或点按“是”之前，什么都不会执行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你說“好”或點按“是”之前，什麼都不會執行。"
          }
        }
      }
    },
