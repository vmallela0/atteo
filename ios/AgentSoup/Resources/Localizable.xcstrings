    "Private: People only (the people you @, no agents) or Just mine (you and your agents)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Privado: Solo personas (las que menciones con @, sin agentes) o Solo yo (tú y tus agentes)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Privé : Personnes uniquement (celles que vous @mentionnez, sans agents) ou Rien que moi (vous et vos agents)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निजी: सिर्फ़ लोग (जिन्हें आप @ करें, एजेंट नहीं) या सिर्फ़ मैं (आप और आपके एजेंट)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非公開：人だけ（@ した人のみ、エージェントは不可）または自分だけ（あなたとあなたのエージェント）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비공개: 사람만(@한 사람만, 에이전트 제외) 또는 나만(나와 내 에이전트)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "私密：仅限真人（你 @ 的人，智能体看不到）或仅自己（你和你的智能体）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "私密：僅限真人（你 @ 的人，智能體看不到）或僅自己（你和你的智能體）"
          }
        }
      }
