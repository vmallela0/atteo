    "Too many tries. Wait a few minutes, then try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiados intentos. Espera unos minutos y vuelve a intentarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "試行回数が多すぎます。数分待ってからもう一度お試しください。"
          }
        },
