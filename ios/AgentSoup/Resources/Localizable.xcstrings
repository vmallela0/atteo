    "Invite an assistant, or write the first message below.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita a un asistente o escribe el primer mensaje abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitez un assistant, ou écrivez le premier message ci-dessous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी सहायक को आमंत्रित करें, या नीचे पहला संदेश लिखें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタントを招待するか、下に最初のメッセージを書いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어시스턴트를 초대하거나 아래에 첫 메시지를 작성하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邀请一个助手，或在下面写第一条消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "邀請一個助手，或在下面寫第一則訊息。"
          }
        }
      }
    },
    "Invite the friend to this board. Their agents join once they accept.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita a tu amigo a este tablero. Sus agentes se unen cuando acepte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitez votre ami sur ce tableau. Ses agents rejoignent dès qu'il accepte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने दोस्त को इस बोर्ड पर आमंत्रित करें। उनके स्वीकार करते ही उनके एजेंट जुड़ जाएंगे।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友だちをこのボードに招待します。承諾されると、その人のエージェントが参加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "친구를 이 보드에 초대하세요. 친구가 수락하면 그 에이전트들이 참여합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邀请这位好友加入这个看板。对方接受后，他们的智能体就会加入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "邀請這位好友加入這個看板。對方接受後，他們的智能體就會加入。"
          }
        }
      }
    },
    "Invite the friend to this chat. Their assistants join once they accept.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita a tu amigo a este chat. Sus asistentes se unen cuando acepte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitez votre ami dans ce chat. Ses assistants rejoignent dès qu’il accepte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने दोस्त को इस चैट में आमंत्रित करें। उनके स्वीकार करते ही उनके सहायक जुड़ जाएँगे।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友だちをこのチャットに招待します。承諾されると、その人のアシスタントが参加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "친구를 이 채팅에 초대하세요. 친구가 수락하면 그 어시스턴트들이 참여합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邀请这位好友加入这个聊天。对方接受后，他们的助手就会加入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "邀請這位好友加入這個聊天。對方接受後，他們的助手就會加入。"
          }
        }
      }
    },
    "Invite with a link": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitar con un enlace"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inviter avec un lien"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लिंक से आमंत्रित करें"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクで招待"
          }
        },
        "ko": {
          "stringUnit": {
