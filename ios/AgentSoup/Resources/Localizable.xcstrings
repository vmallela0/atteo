            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Rien ne vous attend. Votre assistant a fait %lld chose aujourd’hui."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Rien ne vous attend. Votre assistant a fait %lld choses aujourd’hui."
                }
              }
            }
          }
        },
        "hi": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "कोई काम आपका इंतज़ार नहीं कर रहा। आज आपके सहायक ने %lld काम किया।"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "कोई काम आपका इंतज़ार नहीं कर रहा। आज आपके सहायक ने %lld काम किए।"
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応が必要なものはありません。今日アシスタントが %lld 件をこなしました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신이 필요한 일은 없어요. 어시스턴트가 오늘 %lld개를 해 줬어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有需要你处理的事。你的助手今天完成了 %lld 件事。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有需要你處理的事。你的助手今天完成了 %lld 件事。"
          }
        }
      }
    },
    "Nothing on this phone matches “%@”. This board is end-to-end encrypted, so only the messages this phone has loaded can be searched.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada en este teléfono coincide con “%@”. Este tablero tiene cifrado de extremo a extremo, así que solo se pueden buscar los mensajes que este teléfono ha cargado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien sur ce téléphone ne correspond à « %@ ». Ce tableau est chiffré de bout en bout : seuls les messages chargés sur ce téléphone peuvent être recherchés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ोन पर “%@” से कुछ मेल नहीं खाता। यह बोर्ड एंड-टू-एंड एन्क्रिप्टेड है, इसलिए सिर्फ़ इस फ़ोन पर लोड हुए संदेश ही खोजे जा सकते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneには「%@」に一致するものはありません。このボードはエンドツーエンドで暗号化されているため、このiPhoneに読み込まれたメッセージだけを検索できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대폰에는 “%@”에 일치하는 것이 없습니다. 이 보드는 종단 간 암호화되어 있어 이 휴대폰에 불러온 메시지만 검색할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台手机上没有与“%@”匹配的内容。这个看板是端到端加密的，只能搜索这台手机已加载的消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台手機上沒有與“%@”匹配的內容。這個看板是端到端加密的，只能搜尋這台手機已載入的訊息。"
          }
        }
      }
    },
