    "By continuing you agree to Atteo's Terms and Privacy Policy.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al continuar, aceptas los Términos y la Política de privacidad de Atteo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En continuant, vous acceptez les Conditions et la Politique de confidentialité d’Atteo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आगे बढ़कर आप Atteo की शर्तों और गोपनीयता नीति से सहमत होते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続行すると、Atteo の利用規約とプライバシーポリシーに同意したことになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속하면 Atteo의 약관 및 개인정보 처리방침에 동의하게 됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续即表示你同意 Atteo 的条款和隐私政策。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續即表示你同意 Atteo 的條款和隱私政策。"
          }
        }
      }
    },
