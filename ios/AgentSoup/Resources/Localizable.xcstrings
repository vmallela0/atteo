    "Tasks, change cards, #numbers. Turns on by itself if you connect Claude Code or Codex.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tareas, tarjetas de cambios, #números. Se activa solo si conectas Claude Code o Codex."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tâches, cartes de modification, #numéros. S’active tout seul si vous connectez Claude Code ou Codex."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्य, बदलाव कार्ड, #नंबर। Claude Code या Codex कनेक्ट करने पर अपने आप चालू होता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスク、変更カード、#番号。Claude Code または Codex を接続すると自動でオンになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업, 변경 카드, #번호. Claude Code나 Codex를 연결하면 저절로 켜집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务、变更卡片、#编号。连接 Claude Code 或 Codex 后会自动开启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任務、變更卡片、#編號。連線 Claude Code 或 Codex 後會自動開啟。"
          }
        }
      }
    },
    "Tell me more": {
      "localizations": {
