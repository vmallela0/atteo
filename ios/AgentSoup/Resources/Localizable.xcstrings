    "Too many tries. Wait a few minutes, then try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiados intentos. Espera unos minutos y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de tentatives. Patientez quelques minutes, puis réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बहुत ज़्यादा कोशिशें हुईं। कुछ मिनट रुकें, फिर कोशिश करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "試行回数が多すぎます。数分待ってからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시도 횟수가 너무 많습니다. 몇 분 기다린 뒤 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尝试次数过多。请等几分钟再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "嘗試次數過多。請等幾分鐘再試。"
          }
        }
      }
    },
    "Turn on": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activar"
          }
        },
        "fr": {
          "stringUnit": {
