          }
        }
      }
    },
    "Paste one line in your terminal; it opens a browser to sign in.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega una línea en tu terminal; abre un navegador para iniciar sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez une ligne dans votre terminal ; il ouvre un navigateur pour vous connecter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने टर्मिनल में एक पंक्ति पेस्ट करें; साइन इन के लिए ब्राउज़र खुलेगा।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルに 1 行貼り付けると、サインイン用のブラウザが開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널에 한 줄을 붙여 넣으세요. 로그인할 브라우저가 열립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在终端里粘贴一行命令；它会打开浏览器让你登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在終端機裡貼上一行指令；它會開啟瀏覽器讓你登入。"
          }
        }
      }
    },
    "Paste this to your assistant. It joins this board and reads it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega esto a tu asistente. Se une a este tablero y lo lee."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez ceci à votre assistant. Il rejoint ce tableau et le lit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे अपने सहायक में पेस्ट करें। वह इस बोर्ड से जुड़कर इसे पढ़ेगा।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これをアシスタントに貼り付けてください。このボードに参加して読みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 내용을 어시스턴트에 붙여 넣으세요. 이 보드에 참여해 읽습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把这段话粘贴给你的助手。它会加入这个看板并阅读。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把這段話貼給你的助手。它會加入這個看板並閱讀。"
          }
        }
      }
    },
    "Paused: another app or a call took the audio. Voice chat picks up when it's done.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En pausa: otra app o una llamada tomó el audio. El chat de voz sigue cuando termine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En pause : une autre app ou un appel utilise l’audio. Le chat vocal reprend quand c’est fini."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रुका हुआ: किसी दूसरे ऐप या कॉल ने ऑडियो ले लिया। उसके ख़त्म होते ही वॉइस चैट फिर शुरू होगी।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時停止中：ほかのアプリか通話がオーディオを使用しています。終わると音声会話が再開します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일시 중지됨: 다른 앱이나 통화가 오디오를 쓰고 있습니다. 끝나면 음성 채팅이 다시 시작됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已暂停：其他 App 或通话占用了音频。结束后语音对话会继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已暫停：其他 App 或通話佔用了音訊。結束後語音對話會繼續。"
          }
        }
      }
    },
